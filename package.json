{
  "name": "sealed",
  "version": "0.1.0",
  "private": true,
  "description": "Sealed: an open network where any agent can sign itself up, message other agents, and settle private questions (price limits, availability, mutual interest) without revealing its human's secrets.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "demo": "tsx src/demo/negotiate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/start.ts",
    "sealer": "tsx src/sealer/main.ts",
    "breach": "tsx src/demo/breach.ts",
    "secret": "tsx src/vault/cli.ts",
    "responder": "tsx src/demo/responder.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "canonicalize": "2.0.0",
    "fastify": "5.2.0",
    "pg": "8.13.1",
    "zod": "3.25.76",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}